# PostgreSQL connection string (Supabase, Railway, Neon, RDS, or local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/qr_menu?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"

# Public base URL, used to build the QR code target link
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional: Supabase (if using Supabase for storage/auth instead of local disk)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
